htmlcov/

# Frontend
frontend/node_modules/
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Runtime data and downloaded models (large, not source; data/ holds the database, the originals,
# the share-link signing key and the Wallet certificates)
data/
models/

# Secrets and private configuration: never tracked. scripts/run.sh loads .env at the repo root.
.env
.env.*
*.env
!*.env.example
secret.key
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
*.jks
*.keystore
*.mobileprovision
*.pkpass
wallet/
ios/Signing.local.yml
ios/*.local.yml
ios/ExportOptions.plist

# Databases and logs
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log

# iOS build state (the project is generated by xcodegen from ios/project.yml)
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/Sources/Info.plist
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/build/
ios/DerivedData/

# Local tool and editor state
.claude/settings.local.json
.claude/*.local.*
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Hub source kept on disk for porting only
frontend/hub_reference/
backend/app/*_hub_reference.py
backend/app/*/*_hub_reference.py
scripts/*_hub_reference.py

# local
.tmp/
tmp/
scratch/
